    if skeletonEnabled then
        local cam = workspace.CurrentCamera
        if not cam then return end

        local conexionesHuesos = {
            {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
            {"LowerTorso", "LeftUpperLeg"}, {"LowerTorso", "RightUpperLeg"},
            {"LeftUpperLeg", "LeftLowerLeg"}, {"RightUpperLeg", "RightLowerLeg"},
            {"UpperTorso", "LeftUpperArm"}, {"UpperTorso", "RightUpperArm"},
            {"LeftUpperArm", "LeftLowerArm"}, {"RightUpperArm", "RightLowerArm"},
            {"Head", "Torso"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
            {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
        }

        for _, jugador in ipairs(Players:GetPlayers()) do
            if jugador ~= LocalPlayer and jugador.Character then
                if teamCheckEnabled and esDelMismoEquipo(jugador) then
                    local skViejo = espFrame:FindFirstChild("Skeleton_" .. jugador.Character.Name)
                    if skViejo then skViejo:Destroy() end
                    skeletons[jugador.Character] = nil
                    continue
                end

                local personaje = jugador.Character
                local nombre = "Skeleton_" .. personaje.Name

                if not espFrame:FindFirstChild(nombre) then
                    local carpeta = Instance.new("Folder")
                    carpeta.Name = nombre
                    carpeta.Parent = espFrame

                    local lineas = {}
                    for i = 1, 15 do
                        local linea = Instance.new("Frame")
                        linea.Name = "L" .. i
                        linea.BackgroundColor3 = Colors.Skeleton
                        linea.BorderSizePixel = 0
                        linea.AnchorPoint = Vector2.new(0.5, 0.5)
                        linea.ZIndex = 1
                        linea.Visible = false
                        linea.Parent = carpeta
                        lineas[i] = linea
                    end
                    skeletons[personaje] = lineas
                end

                local lineas = skeletons[personaje]
                if lineas then
                    for i, con in ipairs(conexionesHuesos) do
                        local linea = lineas[i]
                        if linea then
                            local a = personaje:FindFirstChild(con[1])
                            local b = personaje:FindFirstChild(con[2])
