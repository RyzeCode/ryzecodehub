                        texto.TextStrokeTransparency = 0
                        texto.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        texto.ZIndex = 4
                        texto.Parent = contenedor
                        local fondo = Instance.new("Frame")
                        fondo.Name = "Fondo"
                        fondo.BackgroundColor3 = Colors.HealthBg
                        fondo.BorderSizePixel = 0
                        fondo.ZIndex = 3
                        fondo.Parent = contenedor
                        local fondoCorner = Instance.new("UICorner")
                        fondoCorner.CornerRadius = UDim.new(1, 0)
                        fondoCorner.Parent = fondo
