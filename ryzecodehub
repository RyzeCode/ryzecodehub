-- ============================
-- MAPA DE CARACTERES SIMILARES (CHAT BYPASS)
-- ============================
local mapaChatBypass = {
    a = {"а", "α"}, b = {"Ь", "ъ"}, c = {"с", "ϲ"}, d = {"ԁ"},
    e = {"е", "ｅ"}, f = {"ғ"}, g = {"ɡ"}, h = {"һ"},
    i = {"і", "ı"}, j = {"ј"}, k = {"κ"}, l = {"ӏ"},
    m = {"м"}, n = {"п"}, o = {"о", "ο"}, p = {"р", "ρ"},
    q = {"ԛ"}, r = {"г"}, s = {"ѕ"}, t = {"т"},
    u = {"ц", "υ"}, v = {"ν"}, w = {"ш", "ԝ"}, x = {"х"},
    y = {"у", "γ"}, z = {"ᴢ"},
    ["0"] = {"О"}, ["1"] = {"І"}, ["3"] = {"З"},
}

local function convertirChatBypass(texto)
    local resultado = ""
    for i = 1, #texto do
        local caracter = texto:sub(i, i)
        local caracterLower = string.lower(caracter)
        if mapaChatBypass[caracterLower] then
            local opciones = mapaChatBypass[caracterLower]
            local randomIndex = math.random(1, #opciones)
            resultado = resultado .. opciones[randomIndex]
        else
            resultado = resultado .. caracter
        end
    end
    return resultado
end

