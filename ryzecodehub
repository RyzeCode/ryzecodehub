                sendBtn.BackgroundColor3 = Colors.ExecuteHover
            end)
            sendBtn.MouseLeave:Connect(function()
                sendBtn.BackgroundColor3 = Colors.Execute
            end)

            local preview = Instance.new("TextLabel")
            preview.Name = "Preview"
            preview.Size = UDim2.new(1, -20, 0, 16)
            preview.Position = UDim2.new(0, 10, 0, 60)
            preview.BackgroundTransparency = 1
            preview.Text = ""
            preview.TextColor3 = Color3.fromRGB(120, 220, 140)
            preview.TextSize = 12
            preview.Font = Enum.Font.Gotham
            preview.TextXAlignment = Enum.TextXAlignment.Left
            preview.ZIndex = 9
