                                    local dist = delta.Magnitude
                                    if dist >= 1 then
                                        local centro = (posA + posB) / 2
                                        local angulo = math.atan2(delta.Y, delta.X)
                                        linea.Visible = true
                                        linea.Size = UDim2.new(0, dist, 0, 2)
                                        linea.Position = UDim2.new(0, centro.X, 0, centro.Y)
