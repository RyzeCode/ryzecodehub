                        contenedor.Name = nombreBarra
                        contenedor.BackgroundTransparency = 1
                        contenedor.BorderSizePixel = 0
                        contenedor.ZIndex = 2
                        contenedor.Parent = espFrame
                        healthBars[jugador] = contenedor

                        local texto = Instance.new("TextLabel")
