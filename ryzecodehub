            tbPadding.Parent = textBox

            local sendBtn = Instance.new("TextButton")
            sendBtn.Name = "Send"
            sendBtn.Size = UDim2.new(0, 90, 0, 28)
            sendBtn.Position = UDim2.new(1, -100, 0, 24)
            sendBtn.BackgroundColor3 = Colors.Execute
            sendBtn.BorderSizePixel = 0
