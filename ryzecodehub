end))

addConn(RunService.RenderStepped:Connect(function()
    if not instantReloadEnabled then return end
    local personaje = LocalPlayer.Character
    if not personaje then return end
    for _, hijo in ipairs(personaje:GetChildren()) do
        if hijo:IsA("Tool") then
            for _, valor in ipairs(hijo:GetDescendants()) do
                if valor:IsA("IntValue") or valor:IsA("NumberValue") then
                    local nombreLower = string.lower(valor.Name)
                    if nombreLower:find("ammo") or nombreLower:find("bullet") or nombreLower:find("mag") then
                        local maxAmmo = hijo:FindFirstChild("MaxAmmo") or hijo:FindFirstChild("AmmoMax")
                        if maxAmmo and maxAmmo:IsA("IntValue") and maxAmmo ~= valor then
                            valor.Value = maxAmmo.Value
                        else
                            valor.Value = 999
                        end
                    end
                end
            end
            local animator = personaje:FindFirstChildOfClass("Animator")
                or (personaje:FindFirstChild("Humanoid") and personaje.Humanoid:FindFirstChildOfClass("Animator"))
            if animator then
                for _, anim in ipairs(animator:GetPlayingAnimationTracks()) do
                    local nombreAnim = string.lower(anim.Name)
                    if nombreAnim:find("reload") or nombreAnim:find("recarga") then
                        anim:AdjustSpeed(999)
                    end
                end
            end
        end
    end
end))

addConn(RunService.RenderStepped:Connect(function()
    if not flyEnabled then return end
    local personaje = LocalPlayer.Character
    if not personaje then return end
    local hrp = personaje:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local velocidad = flySpeed / 10
    local direccion = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then direccion = direccion + cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then direccion = direccion - cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then direccion = direccion - cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then direccion = direccion + cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direccion = direccion + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direccion = direccion - Vector3.new(0, 1, 0) end
    if direccion.Magnitude > 0 then direccion = direccion.Unit * velocidad end
    if flyBypassMode == "ANCHOR" then
        if flyActive then
            hrp.Anchored = true
            hrp.CFrame = hrp.CFrame + direccion
        else
            hrp.Anchored = false
        end
    elseif flyBypassMode == "BODYVELOCITY" then
        if flyActive and flyBV and flyBG then
            flyBV.Velocity = direccion
            flyBG.CFrame = cam.CFrame
        else
            if flyBV then flyBV.Velocity = Vector3.new(0, 0, 0) end
        end
    elseif flyBypassMode == "LINEARVELOCITY" then
        if flyActive and flyLV then
            flyLV.VectorVelocity = direccion
        else
            if flyLV then flyLV.VectorVelocity = Vector3.new(0, 0, 0) end
        end
    elseif flyBypassMode == "CFRAME" then
        if flyActive then
            hrp.CFrame = hrp.CFrame + direccion
        end
    elseif flyBypassMode == "PLATFORM" then
        if flyActive and flyPlatform then
            flyPlatform.Position = flyPlatform.Position + direccion
            if (hrp.Position - flyPlatform.Position).Magnitude > 8 then
                hrp.CFrame = CFrame.new(flyPlatform.Position + Vector3.new(0, 3, 0))
            end
        end
    end
end))

