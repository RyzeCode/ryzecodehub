                                relleno.BackgroundColor3 = Colors.HealthYellow
                            else
                                relleno.BackgroundColor3 = Colors.HealthRed
                            end
                            if texto then
                                texto.Text = tostring(math.floor(vida * 100)) .. "%"
                            end
                        end
                    else
                        contenedor.Visible = false
                    end
                end
            end
        end
