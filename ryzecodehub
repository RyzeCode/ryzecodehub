                        relleno.Position = UDim2.new(0, 0, 1, 0)
                        relleno.BackgroundColor3 = Colors.HealthGreen
                        relleno.BorderSizePixel = 0
                        relleno.ZIndex = 4
                        relleno.Parent = fondo
                        local rellenoCorner = Instance.new("UICorner")
                        rellenoCorner.CornerRadius = UDim.new(1, 0)
                        rellenoCorner.Parent = relleno
                    end
                    local cabeza = personaje:FindFirstChild("Head") or hrp
                    local posCabeza, enCabeza = cam:WorldToViewportPoint(cabeza.Position)
                    local posPies, enPies = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    if enCabeza and posCabeza.Z > 0 and enPies and posPies.Z > 0 then
                        contenedor.Visible = true
                        local alturaPersonaje = math.abs(posPies.Y - posCabeza.Y)
                        alturaPersonaje = math.clamp(alturaPersonaje, 20, 300)
                        local alturaBarra = alturaPersonaje * 0.7
                        local anchoBarra = math.clamp(alturaPersonaje * 0.06, 3, 8)
                        local tamanoTexto = math.clamp(alturaPersonaje * 0.2, 8, 16)
                        contenedor.Size = UDim2.new(0, anchoBarra, 0, alturaBarra)
                        contenedor.Position = UDim2.new(0, posCabeza.X + anchoBarra + 14, 0, posCabeza.Y)
