                                local pa, onA = cam:WorldToViewportPoint(a.Position)
                                local pb, onB = cam:WorldToViewportPoint(b.Position)
                                if onA and onB then
                                    local posA = Vector2.new(pa.X, pa.Y)
                                    local posB = Vector2.new(pb.X, pb.Y)
                                    local delta = posB - posA
                                    local dist = delta.Magnitude
                                    if dist >= 1 then
                                        local centro = (posA + posB) / 2
                                        local angulo = math.atan2(delta.Y, delta.X)
                                        linea.Visible = true
                                        linea.Size = UDim2.new(0, dist, 0, 2)
                                        linea.Position = UDim2.new(0, centro.X, 0, centro.Y)
                                        linea.Rotation = math.deg(angulo)
                                    else
