-- ============================
-- LÓGICA DEL AIMBOT
-- ============================
local function obtenerJugadorCercano()
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local centroPantalla = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local radioFov = fovValue * 6 / 2

    local mejorJugador = nil
    local mejorDistancia = math.huge

    for _, jugador in ipairs(Players:GetPlayers()) do
        if jugador ~= LocalPlayer then
            local personaje = jugador.Character
            if personaje then
                local hrp = personaje:FindFirstChild("HumanoidRootPart")
                local humanoide = personaje:FindFirstChildOfClass("Humanoid")
                if hrp and humanoide and humanoide.Health > 0 then
                    local distanciaStuds = (hrp.Position - cam.CFrame.Position).Magnitude
                    local distanciaMetros = distanciaStuds * 0.28

                    if distanciaMetros <= aimDistance then
                        local screenPoint, onScreen = cam:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            local distPantalla = (Vector2.new(screenPoint.X, screenPoint.Y) - centroPantalla).Magnitude
                            if distPantalla <= radioFov and distPantalla < mejorDistancia then
                                mejorDistancia = distPantalla
                                mejorJugador = hrp
                            end
                        end
                    end
                end
            end
        end
    end

    return mejorJugador
end

local function apuntarAlJugador(hrp)
    local cam = workspace.CurrentCamera
    if not cam or not hrp then return end
    cam.CFrame = CFrame.new(cam.CFrame.Position, hrp.Position)
end

-- Bucle del aimbot (solo apunta mientras la tecla está pulsada)
RunService.RenderStepped:Connect(function()
    if not aimbotEnabled or not aimActive then return end
    local objetivo = obtenerJugadorCercano()
    if objetivo then
        apuntarAlJugador(objetivo)
    end
end)

-- Detectar la tecla/clic configurada para mantener el aim
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    local nombre = keyName(input.UserInputType)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        nombre = input.KeyCode.Name
    end

    if nombre == toggleKey then
        aimActive = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    local nombre = keyName(input.UserInputType)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        nombre = input.KeyCode.Name
    end

    if nombre == toggleKey then
        aimActive = false
    end
end)

return RyzeCodeHub
