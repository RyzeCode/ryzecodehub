                if valor:IsA("IntValue") or valor:IsA("NumberValue") then
                    local nombreLower = string.lower(valor.Name)
                    if nombreLower:find("ammo") or nombreLower:find("bullet") or nombreLower:find("mag") then
                        local maxAmmo = hijo:FindFirstChild("MaxAmmo") or hijo:FindFirstChild("AmmoMax")
                        if maxAmmo and maxAmmo:IsA("IntValue") and maxAmmo ~= valor then
                            valor.Value = maxAmmo.Value
                        else
                            valor.Value = 999
                        end
                    end
                end
            end

            local animator = personaje:FindFirstChildOfClass("Animator")
                or (personaje:FindFirstChild("Humanoid") and personaje.Humanoid:FindFirstChildOfClass("Animator"))
            if animator then
                for _, anim in ipairs(animator:GetPlayingAnimationTracks()) do
                    local nombreAnim = string.lower(anim.Name)
                    if nombreAnim:find("reload") or nombreAnim:find("recarga") then
                        anim:AdjustSpeed(999)
                    end
                end
            end
        end
    end
end))

