local function estaMuerto(personaje)
    if not personaje then return true end
    if not personaje.Parent then return true end
    local humanoide = personaje:FindFirstChildOfClass("Humanoid")
    if not humanoide then return true end
    if humanoide.Health <= 0 then return true end
    local estado = humanoide:GetState()
    if estado == Enum.HumanoidStateType.Dead or estado == Enum.HumanoidStateType.None then return true end
    return false
end

local function checkManual(jugador) return aliados[jugador.Name] == true end
local function checkTeam(jugador)
    if not LocalPlayer.Team or not jugador.Team then return false end
    return jugador.Team == LocalPlayer.Team
end
local function checkTeamColor(jugador)
    if not LocalPlayer.TeamColor or not jugador.TeamColor then return false end
    return jugador.TeamColor == LocalPlayer.TeamColor
end
local function checkBodyColor(jugador)
    if jugador == LocalPlayer then return true end
    if not jugador.Character or not LocalPlayer.Character then return false end
    local bcLocal = LocalPlayer.Character:FindFirstChildOfClass("BodyColors")
    local bcOtro = jugador.Character:FindFirstChildOfClass("BodyColors")
    if not bcLocal or not bcOtro then return false end
    return bcLocal.TorsoColor3 == bcOtro.TorsoColor3 and bcLocal.HeadColor3 == bcOtro.HeadColor3
end

local function esDelMismoEquipo(jugador)
    if checkManual(jugador) then return true end
    if teamCheckMode == "MANUAL" then return false
    elseif teamCheckMode == "TEAM" then return checkTeam(jugador)
    elseif teamCheckMode == "TEAMCOLOR" then return checkTeamColor(jugador)
    elseif teamCheckMode == "BODYCOLOR" then return checkBodyColor(jugador)
    else
        if checkTeam(jugador) then return true end
        if checkTeamColor(jugador) then return true end
        if checkBodyColor(jugador) then return true end
        return false
    end
end

local function obtenerPuntoObjetivo(personaje, forzarCabeza)
    if forzarCabeza or boneAim == "HEAD" then
        local cabeza = personaje:FindFirstChild("Head")
        if cabeza then return cabeza end
    end
    return personaje:FindFirstChild("HumanoidRootPart")
        or personaje:FindFirstChild("UpperTorso")
        or personaje:FindFirstChild("Torso")
end

local function hayParedEntre(desde, hasta, ignorarPersonaje)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local filtros = {}
    if LocalPlayer.Character then table.insert(filtros, LocalPlayer.Character) end
    if ignorarPersonaje then table.insert(filtros, ignorarPersonaje) end
    rayParams.FilterDescendantsInstances = filtros
    local direccion = hasta - desde
    local resultado = workspace:Raycast(desde, direccion, rayParams)
    if not resultado then return false end
    local golpeado = resultado.Instance
    if ignorarPersonaje and golpeado:IsDescendantOf(ignorarPersonaje) then return false end
    if LocalPlayer.Character and golpeado:IsDescendantOf(LocalPlayer.Character) then return false end
    return true
end

local function obtenerJugadorCercano(forzarCabeza, ignorarParedes)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local centroPantalla = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local radioFov = fovValue * 6 / 2
    local mejorObjetivo = nil
    local mejorDistancia = math.huge
    for _, jugador in ipairs(Players:GetPlayers()) do
        if jugador ~= LocalPlayer then
            local personaje = jugador.Character
            if personaje and personaje.Parent then
                if estaMuerto(personaje) and not targetDead then continue end
                if teamCheckEnabled and esDelMismoEquipo(jugador) then continue end
                local puntoObjetivo = obtenerPuntoObjetivo(personaje, forzarCabeza)
                if puntoObjetivo then
                    if wallCheck and not ignorarParedes then
                        if hayParedEntre(cam.CFrame.Position, puntoObjetivo.Position, personaje) then
                            continue
                        end
                    end
                    local distanciaStuds = (puntoObjetivo.Position - cam.CFrame.Position).Magnitude
                    local distanciaMetros = distanciaStuds * 0.28
                    if distanciaMetros <= aimDistance then
                        local screenPoint, onScreen = cam:WorldToViewportPoint(puntoObjetivo.Position)
                        if onScreen then
                            local distPantalla = (Vector2.new(screenPoint.X, screenPoint.Y) - centroPantalla).Magnitude
                            if distPantalla <= radioFov and distPantalla < mejorDistancia then
                                mejorDistancia = distPantalla
                                mejorObjetivo = puntoObjetivo
                            end
                        end
                    end
                end
            end
        end
    end
    return mejorObjetivo
end

local ultimoObjetivo = nil
local ultimoObjetivoPos = nil
local ultimoObjetivoContador = 0
local MAX_FRAMES_SIN_OBJETIVO = 15

local conexiones = {}
local function addConn(conn)
    table.insert(conexiones, conn)
    return conn
end

addConn(RunService.RenderStepped:Connect(function()
    if not aimbotEnabled or not aimActive then
        ultimoObjetivo = nil
        ultimoObjetivoPos = nil
        ultimoObjetivoContador = 0
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local objetivo = obtenerJugadorCercano(false, magicBulletEnabled)
    if objetivo then
        ultimoObjetivo = objetivo
        ultimoObjetivoPos = objetivo.Position
        ultimoObjetivoContador = 0
    else
        if ultimoObjetivo and ultimoObjetivo.Parent then
            ultimoObjetivoContador = ultimoObjetivoContador + 1
            if ultimoObjetivoContador <= MAX_FRAMES_SIN_OBJETIVO then
                objetivo = ultimoObjetivo
            else
                ultimoObjetivo = nil
                ultimoObjetivoPos = nil
                ultimoObjetivoContador = 0
                return
            end
        else
            return
        end
    end
    local targetPos
    if objetivo.Parent then
        targetPos = objetivo.Position
    elseif ultimoObjetivoPos then
        targetPos = ultimoObjetivoPos
    else
        return
    end
    local origen
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then origen = hrp.Position else origen = cam.CFrame.Position end
    local factor = 1 - (smoothValue / 100)
    factor = math.clamp(factor, 0.03, 1)
    local direccion = (targetPos - origen).Unit
    local targetCFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + direccion)
    cam.CFrame = cam.CFrame:Lerp(targetCFrame, factor)
end))

