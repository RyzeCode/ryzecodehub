                if textBox.Text ~= "" then
                    preview.Text = "→ " .. convertirChatBypass(textBox.Text)
                else
                    preview.Text = ""
                end
            end)

            local function enviar()
                if textBox.Text == "" then return end
                local textoBypass = convertirChatBypass(textBox.Text)

                -- Enviar el mensaje al chat de Roblox usando el NUEVO sistema (TextChatService)
                pcall(function()
                    local TextChatService = game:GetService("TextChatService")
                    local TextChannels = TextChatService:FindFirstChild("TextChannels")
                    if not TextChannels then return end

                    local canalGeneral = TextChannels:FindFirstChild("RBXGeneral")
                    if not canalGeneral then
                        for _, canal in ipairs(TextChannels:GetChildren()) do
                            if canal:IsA("TextChannel") then
                                canalGeneral = canal
                                break
                            end
                        end
                    end

                    if canalGeneral then
                        canalGeneral:SendAsync(textoBypass)
                    end
                end)

                pcall(callback, textoBypass, textBox.Text)
                textBox.Text = ""
                preview.Text = ""
            end

            sendBtn.MouseButton1Click:Connect(enviar)
            textBox.FocusLost:Connect(function(enterPressed)
                if enterPressed then enviar() end
            end)

            return textBox, function() return textBox.Text end
        end

        tabs[#tabs + 1] = { Button = tabButton, Content = tabContent }

